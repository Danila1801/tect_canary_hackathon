# Copy to .env.local and fill in. Never commit real values.
# Any OpenAI-compatible endpoint works. Default: Nebius Token Factory.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
SESSION_SECRET=

# One password per demo persona, 12+ characters each.
CANARY_PASSWORD_ANN=
CANARY_PASSWORD_MARC=
CANARY_PASSWORD_SOFIE=

# Allow admins to re-run the full scan from the UI (costs ~30 model calls).
ALLOW_LIVE_SCAN=false

# Optional: pin "today" for reproducible trust scores.
CANARY_TODAY=2026-09-30
